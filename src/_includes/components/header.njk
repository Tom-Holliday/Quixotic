{# ---------- Header ---------- #}
<header class="site-head">
  <div class="inner container site-head__inner">

    <!-- Left -->
    <div class="site-head__left site-head__left--with-cta">
      <button
        id="theme-toggle"
        class="theme-toggle theme-toggle--modern"
        type="button"
        aria-label="Toggle theme"
      >
        <span aria-hidden="true">🌓</span>
      </button>

      {% if substack and substack.url %}
        <a
          href="{{ substack.url }}"
          target="_blank"
          rel="noopener"
          class="qx-notes-btn"
          aria-label="Substack"
        >
          <img
            src="{{ '/assets/img/substack-logo.png' | url }}"
            alt=""
            class="qx-notes-btn__logo"
            aria-hidden="true"
          />
          <span class="qx-notes-btn__bubble" aria-hidden="true">
            Substack
          </span>
        </a>
      {% endif %}
    </div>

    <!-- Center mast -->
    <div class="site-head__mast">
      <a href="{{ '/' | url }}" class="site-head__mast-link" rel="home">
        Quixotic
      </a>
    </div>

    <!-- Right -->
    <div class="site-head__right">
      <nav class="nav nav--clean" aria-label="Primary">
        <a
          href="{{ '/posts/' | url }}"
          class="{% if page.url and page.url.startsWith('/posts/') %}active{% endif %}"
        >
          Posts
        </a>

        <a
          href="{{ '/data/' | url }}"
          class="{% if page.url and page.url.startsWith('/data/') %}active{% endif %}"
        >
          Data &amp; Infographics
        </a>
      </nav>
    </div>

  </div>
</header>